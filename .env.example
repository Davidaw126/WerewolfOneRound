# Copy to .env for local development.

# Redis connection string. Defaults to redis://127.0.0.1:6379 if unset.
REDIS_URL=redis://127.0.0.1:6379

# HMAC secret used to sign session cookies. Required - generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
